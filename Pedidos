
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kiwua Zushi | Pedidos</title>

<style>
* { box-sizing: border-box; }

body {
  font-family: Arial, sans-serif;
  background: #f3f5f4;
  margin: 0;
  color: #24332d;
}

header {
  background: #153e34;
  color: white;
  text-align: center;
  padding: 24px 15px;
}

header h1 { margin: 0 0 8px; }
header p { margin: 0; }

main {
  max-width: 650px;
  margin: auto;
  padding: 15px;
}

.card {
  background: white;
  border-radius: 12px;
  padding: 18px;
  margin-bottom: 15px;
  box-shadow: 0 2px 8px #00000010;
}

h2 { font-size: 19px; margin-top: 0; }

label {
  display: block;
  font-weight: bold;
  margin: 12px 0 7px;
}

input[type="text"], select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #c5d0ca;
  border-radius: 8px;
  font-size: 16px;
}

textarea { min-height: 75px; }

.producto {
  display: grid;
  grid-template-columns: 26px 1fr 105px;
  gap: 8px;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.producto label {
  margin: 0;
  font-weight: normal;
}

.producto input[type="checkbox"] {
  width: 22px;
  height: 22px;
  accent-color: #167a52;
}

.producto input[type="text"] {
  padding: 9px 5px;
  font-size: 14px;
}

.producto input:disabled {
  background: #eeeeee;
}

button {
  width: 100%;
  padding: 15px;
  border: none;
  border-radius: 9px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 10px;
}

.enviar {
  background: #25D366;
  color: white;
}

.copiar {
  background: #e3eee8;
  color: #174936;
}

.info {
  background: #fff5d9;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  margin-top: 15px;
}

#contador {
  color: #167a52;
  font-weight: bold;
}

#error {
  color: #bd2929;
  font-weight: bold;
}

footer {
  text-align: center;
  padding: 20px;
  color: #68736e;
  font-size: 12px;
}
</style>
</head>

<body>

<header>
  <h1>🍣 KIWUA ZUSHI</h1>
  <p>Sistema de pedidos de insumos</p>
</header>

<main>

<section class="card">
  <h2>📋 Nuevo pedido</h2>

  <label for="colaborador">Nombre del colaborador</label>
  <input id="colaborador" type="text"
         placeholder="Escribe tu nombre">

  <label for="proveedor">Selecciona el proveedor o área</label>
  <select id="proveedor"></select>

  <div class="info">
    Revisa las existencias antes de pedir.
    Marca los productos necesarios y escribe
    la cantidad con su unidad: kg, piezas,
    cajas, litros, etc.
  </div>
</section>

<section class="card">
  <h2>📦 Productos</h2>
  <p id="contador">0 seleccionados</p>
  <div id="productos"></div>
</section>

<section class="card">
  <h2>📝 Finalizar pedido</h2>

  <label for="observaciones">Observaciones</label>
  <textarea id="observaciones"
    placeholder="Ejemplo: Se necesita para el viernes">
  </textarea>

  <p id="error"></p>

  <button class="enviar" onclick="enviarPedido()">
    📲 Enviar por WhatsApp
  </button>

  <button class="copiar" onclick="copiarPedido()">
    📋 Copiar pedido
  </button>

  <p style="font-size:13px;color:#666">
    El pedido se abrirá en WhatsApp.
    El colaborador deberá confirmar el envío.
    Todos los pedidos quedan pendientes
    de autorización.
  </p>
</section>

</main>

<footer>
  Kiwua Zushi · Control interno de pedidos
</footer>

<script>

// WHATSAPP QUE RECIBIRÁ LOS PEDIDOS
const telefono = "526241297955";

// CATÁLOGO DE PROVEEDORES Y PRODUCTOS
