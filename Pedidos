// ELEMENTOS DE LA PÁGINA
const selector = document.getElementById("proveedor");
const contenedor = document.getElementById("productos");
const contador = document.getElementById("contador");
const error = document.getElementById("error");

// GUARDAR SELECCIONES AL CAMBIAR DE PROVEEDOR
const seleccionados = {};

// CARGAR PROVEEDORES
Object.keys(inventario).forEach(nombre => {
  const opcion = document.createElement("option");
  opcion.value = nombre;
  opcion.textContent = nombre;
  selector.appendChild(opcion);
});

// MOSTRAR PRODUCTOS
function mostrarProductos() {
  const proveedor = selector.value;
  contenedor.replaceChildren();

  inventario[proveedor].forEach((producto, indice) => {
    const clave = proveedor + "|" + indice;
    const guardado = seleccionados[clave] || {};

    const fila = document.createElement("div");
    fila.className = "producto";

    const check = document.createElement("input");
    check.type = "checkbox";
    check.id = "p" + indice;
    check.checked = !!guardado.marcado;

    const etiqueta = document.createElement("label");
    etiqueta.htmlFor = check.id;
    etiqueta.textContent = producto;

    const cantidad = document.createElement("input");
    cantidad.type = "text";
    cantidad.placeholder = "Cantidad";
    cantidad.value = guardado.cantidad || "";
    cantidad.disabled = !check.checked;

    check.addEventListener("change", () => {
      cantidad.disabled = !check.checked;
      seleccionados[clave] = {
        marcado: check.checked,
        cantidad: cantidad.value
      };
      actualizarContador();
    });

    cantidad.addEventListener("input", () => {
      seleccionados[clave] = {
        marcado: check.checked,
        cantidad: cantidad.value
      };
    });

    fila.append(check, etiqueta, cantidad);
    contenedor.appendChild(fila);
  });

  actualizarContador();
}

// CONTAR PRODUCTOS SELECCIONADOS
function actualizarContador() {
  const proveedor = selector.value;
  let total = 0;

  inventario[proveedor].forEach((producto, indice) => {
    const clave = proveedor + "|" + indice;
    if (seleccionados[clave]?.marcado) total++;
  });

  contador.textContent = total + " seleccionados";
}

// PREPARAR MENSAJE
function prepararMensaje() {
  error.textContent = "";

  const nombre = document.getElementById("colaborador")
    .value.trim();
  const proveedor = selector.value;
  const observaciones = document.getElementById("observaciones")
    .value.trim();

  if (!nombre) {
    error.textContent = "Escribe tu nombre.";
    return null;
  }

  const productos = [];

  inventario[proveedor].forEach((producto, indice) => {
    const clave = proveedor + "|" + indice;
    const dato = seleccionados[clave];

    if (dato?.marcado) {
      productos.push({
        nombre: producto,
        cantidad: (dato.cantidad || "").trim()
      });
    }
  });

  if (productos.length === 0) {
    error.textContent = "Selecciona al menos un producto.";
    return null;
  }

  if (productos.some(p => !p.cantidad)) {
    error.textContent = "Indica la cantidad de cada producto.";
    return null;
  }

  const fecha = new Date().toLocaleDateString("es-MX");

  let mensaje = "🍣 *KIWUA ZUSHI*\n";
  mensaje += "📦 *SOLICITUD DE PEDIDO*\n\n";
  mensaje += "📅 Fecha: " + fecha + "\n";
  mensaje += "👨‍🍳 Colaborador: " + nombre + "\n";
  mensaje += "🏪 Proveedor/área: " + proveedor + "\n\n";
  mensaje += "*PRODUCTOS SOLICITADOS:*\n";

  productos.forEach(p => {
    mensaje += "✅ " + p.nombre + " - " + p.cantidad + "\n";
  });

  if (observaciones) {
    mensaje += "\n📝 Observaciones: " + observaciones + "\n";
  }

  mensaje += "\n⏳ *PENDIENTE DE AUTORIZACIÓN*";

  return mensaje;
}

// ENVIAR A WHATSAPP
function enviarPedido() {
  const mensaje = prepararMensaje();
  if (!mensaje) return;

  const url = "https://wa.me/" + telefono +
    "?text=" + encodeURIComponent(mensaje);

  window.location.href = url;
}

// COPIAR PEDIDO
async function copiarPedido() {
  const mensaje = prepararMensaje();
  if (!mensaje) return;

  try {
    await navigator.clipboard.writeText(mensaje);
    error.style.color = "green";
    error.textContent = "Pedido copiado correctamente.";
  } catch {
    window.prompt("Copia tu pedido:", mensaje);
  }
}

// INICIAR
selector.addEventListener("change", mostrarProductos);
mostrarProductos();

</script>

